# Speech-to-text
# STT_MODE=local -> free, offline, faster-whisper only (agent cleans up the text)
# STT_MODE=api   -> clean text from an OpenAI-compatible API + word timings from local whisper
STT_MODE=local
STT_LANGUAGE=fa

# local whisper: tiny | base | small | medium | large-v3   (bigger = more accurate, slower)
WHISPER_LOCAL_MODEL=small
WHISPER_DEVICE=cpu

# only for STT_MODE=api (OpenAI: https://api.openai.com/v1 · Groq: https://api.groq.com/openai/v1)
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=gpt-4o-transcribe
STT_API_KEY=
